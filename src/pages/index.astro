---
import "/src/styles/global.css";
import packageJson from "../../package.json";

const version = packageJson.version;
---

<!-- HTML Setup -->
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>enjoy your stay.</title>
		<link
			rel="stylesheet"
			href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css"
		/>
		<link rel="icon" type="image/svg+xml" href="../images/icon.svg" />
	</head>
	<!-- Main Page -->
	<body>
		<div class="nature-bg">
			<!-- Navigation -->
			<header class="navigation" style="width: 100%">
				<nav>
					<a href="/" style="background:#010" class="a-btn"
						><img src="../images/pfp.png" width="25" /></a
					>
					<a href="#now" class="wide qilka-bold a-btn">In the Works</a
					>
					<a href="#proj" class="wide qilka-bold a-btn">Projects</a>
					<a href="#mus" class="wide qilka-bold a-btn">Music</a>
				</nav>
			</header>

			<!-- Greetings -->
			<header class="title">
				<h1 class="orange-avenue wide" style="margin-top: 150px;">
					Welcome to<br /><span class="fancy">m0ssyv1rus</span>
				</h1>
				<h2
					class="qilka-bold wide"
					style="margin-top: 2rem; font-size: 20px"
				>
					<span style="color:#142">
						hosted by yours truly (>vO)&deg;</span
					>
				</h2>
			</header>

			<!-- --Content-- -->
			<main class="main-content">
				<!-- Now -->
				<h3 class="xanmono container" id="now">what's happening in this very microinstance:</h3>
				<ul class="qilka-bold" style="margin-left: 40px">
					<li class="fancy">working on this website!</li>
				</ul>
				<ul class="qilka-bold" style="margin-left: 40px">
					<li>
						school... junior year's kicking my ass ;-;
					</li>
				</ul>

				<!-- Current Projects -->
				<h3 class="xanmono container" id="proj">
					digital concoctions:
				</h3>
				<ul class="qilka-bold" style="margin-left: 40px">
					<a
						href="https://under-the-briar.itch.io/fruits-vs-bugs-ground-zero"
						target="_blank"
						style="color: #5c6"
						class="a-btn">Fruits vs. Bugs: Ground Zero</a
					>
				</ul>

				<!-- Music -->
				<h3 class="xanmono container" id="mus">
					orchestrated frequencies:
				</h3>
				<div class="qilka-bold" style="margin-left: 20px">
					<p>
						(note: no music published yet, but when i have time, i
						will start working on some songs)
					</p>
					<br />
					<div style="margin-left: 20px">
						<a
							href="https://m0ssyv1rus.bandcamp.com"
							target="_blank"
							style="background:turquoise"
							class="a-btn"
						>
							<i
								class="fa-brands fa-bandcamp"
								style="font-size: 2rem; color:#404040;"></i>
						</a>
						<a
							href="https://soundcloud.com/m0ssyv1rus"
							target="_blank"
							style="background:orangered"
							class="a-btn"
						>
							<i
								class="fa-brands fa-soundcloud"
								style="font-size: 2rem; color:#404040;"></i>
						</a>
					</div>
				</div>

				<!-- Footer -->
				<footer class="footer" style="margin-top: 3rem">
					<div class="footer-container">
						<div class="footer-col">
							<h3
								class="xanmono container"
								,
								style="font-weight: bold"
							>
								m0ssyv1rus
							</h3>
							<p class="qilka-bold">
								korean american finding my way through the world
								and the internet
							</p>
						</div>

						<div class="footer-col">
							<h3
								class="xanmono container"
								style="font-weight: bold"
							>
								Quik Linx
							</h3>
							<ul class="qilka-bold">
								<li>
									<a href="#now" style="color:var(--text)"
										>In the Works</a
									>
								</li>
								<li>
									<a href="#proj" style="color:var(--text)"
										>Projects</a
									>
								</li>
								<li>
									<a href="#mus" style="color:var(--text)"
										>Music</a
									>
								</li>
							</ul>
						</div>

						<div class="footer-col">
							<h3
								class="xanmono container"
								style="font-weight: bold"
								id="comm"
							>
								contax:
							</h3>
							<div class="social-links">
								<a
									href="https://www.youtube.com/@m0ssyv1rus"
									target="_blank"
								>
									<i
										class="fa-brands fa-youtube"
										style="font-size: 2rem; color: var(--text);"
									></i>
								</a>
								<a
									href="#"
									onclick="this.href='mailto:' + 'mehonbcats' + '@' + 'gmail.com'"
									target="_blank"
								>
									<i
										class="fa-solid fa-at"
										style="font-size: 2rem; color: var(--text);"
									></i>
								</a>
								<a
									href="https://www.instagram.com/_m0ssyv1rus/"
									target="_blank"
								>
									<i
										class="fa-brands fa-instagram"
										style="font-size: 2rem; color: var(--text);"
									></i>
								</a>
								<a href="#" target="_blank">
									<i
										class="fa-brands fa-square-linkedin"
										style="font-size: 2rem; color: var(--text);"
									>
									</i>
								</a>
							</div>
						</div>
					</div>

					<div class="footer-bottom">
						<p class="qilka-bold">
							&copy; 2026 All rights reserved.
						</p>
						<p class="qilka-bold" style="font-size: 12px">
							Version {version}
							<p></p>
						</p>
					</div>
				</footer>
			</main>
		</div>
	</body>
</html>
